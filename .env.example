# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Demo Mode (set to 'true' to use simulated data without backend)
VITE_DEMO_MODE=true

# Feature Flags
VITE_ENABLE_EXPORT=true
VITE_ENABLE_MODEL_SELECTION=true
VITE_ENABLE_ADVANCED_SETTINGS=false

# Analytics (optional)
VITE_ANALYTICS_ID=

# Sentry Error Tracking (optional)
VITE_SENTRY_DSN=
