# Application Settings
APP_NAME=DeepSea eDNA AI Backend
APP_VERSION=2.1.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=3000
WORKERS=4

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/edna_db
REDIS_URL=redis://localhost:6379/0

# File Storage
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/results
MODEL_DIR=./ml_models
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes

# Deep Learning Models
DEFAULT_MODEL=deeptaxa_v2.1
MODEL_DEVICE=cuda  # cuda or cpu
BATCH_SIZE=32
MAX_SEQUENCE_LENGTH=1000

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Keys (for external services)
NCBI_API_KEY=your_ncbi_api_key_here
BOLD_API_KEY=your_bold_api_key_here

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Model Training
TRAINING_DATA_DIR=./data/training
VALIDATION_SPLIT=0.2
EPOCHS=50
LEARNING_RATE=0.001

# Reference Databases
NCBI_TAXONOMY_DB=./data/ncbi_taxonomy
BOLD_DATABASE=./data/bold_db
CUSTOM_REFERENCE_DB=./data/custom_refs
